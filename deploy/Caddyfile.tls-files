# Caddyfile.tls-files —— 用**现成的证书文件**（acme.sh / 公司证书 / 任何 PEM）
#
# 适用场景：你已经有 `fullchain.pem` + `privkey.pem`（例如 acme.sh 签好的），
# 不想让 Caddy 自己去 ACME、也不想动 NAS 系统目录里的证书。
#
# 用法（在 deploy/.env 里设 CADDYFILE=Caddyfile.tls-files，然后 docker compose up -d caddy）：
#   1. 把证书放进 deploy/certs/（本文件假定挂载到容器的 /certs）
#        deploy/certs/fullchain.pem
#        deploy/certs/privkey.pem        ← 权限建议 600
#   2. deploy/.env 里设置域名（必须与证书里的名字一致，否则浏览器不认）：
#        SITE_ADDRESS=english.example.com
#        COOKIE_SECURE=1
#   3. 启动：
#        docker compose up -d voice web caddy
#
# 说明：
#   · 本文件**没有**写 `:80 { redir ... }` —— NAS 上 80 通常被系统 Nginx 占用，
#     容器内即使监听也映射不出来，写了只会误导。
#   · 也不写 HSTS：确认证书链被所有家庭设备信任后再自行打开（见文件末尾注释）。

{
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2 h3
	}
}

# 站点地址由 .env 的 SITE_ADDRESS 决定，必须与证书 SAN 完全一致
{$SITE_ADDRESS:localhost} {
	tls /certs/fullchain.pem /certs/privkey.pem

	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 90s
				write_timeout 90s
			}
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}

	# 确认所有设备都信任这张证书后，再取消下面这行注释（HSTS 一旦进过浏览器就很难撤回）
	# header Strict-Transport-Security "max-age=31536000"

	log {
		output stdout
		format console
		level INFO
	}
}
