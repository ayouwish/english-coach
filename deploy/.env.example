# english-coach · 部署环境变量（复制为 deploy/.env 后按需修改）
#   cp .env.example .env
# 规则：.env 永远不进 git；没有密钥时 PROVIDER_MODE=mock 也能全链路跑通（离线开发/演示）。
# 「必填」= 不填就起不来；「可选」= 不填走默认值。

# ══════════════════════════════════════════════════════════════════════════════
# 1) 部署入口 / TLS —— 必填（决定你从哪个网址访问、麦克风能不能用）
# ══════════════════════════════════════════════════════════════════════════════
# 站点地址。三选一：
#   localhost             本机访问（浏览器把 localhost 当安全上下文，其实不需要证书）
#   192.168.1.23          局域网按 IP 访问（改成你宿主机的真实局域网 IP）
#   coach.example.com     公网域名（配合下面的 TLS_CERT_MODE=邮箱）
# 注意：不要写 http:// 前缀，只写主机名或 IP。
SITE_ADDRESS=localhost

# 证书模式。二选一：
#   internal              用 Caddy 内置 CA 自签（家庭/局域网推荐；客户端要导入 root.crt）
#   you@example.com       走 Let's Encrypt 自动申请（需要 80/443 能从公网访问）
TLS_CERT_MODE=internal

# ══════════════════════════════════════════════════════════════════════════════
# 2) voice 服务：provider 总开关 —— 必填
# ══════════════════════════════════════════════════════════════════════════════
# mock   : 确定性假数据，零密钥零下载，用于开发/演示/E2E 测试
# local  : 本地模型（faster-whisper 词级 + edge-tts），零 API 费用，无音素级
# cloud  : 全云（Azure 发音评测 + Azure TTS + 云 LLM），效果最好、按量计费
# hybrid : 云为主 + 本地兜底（本项目的目标形态）
PROVIDER_MODE=mock

# 分项覆盖（可选）。留空则按 PROVIDER_MODE 推导；只填一项即可单独切换某个环节。
# 例：PROVIDER_MODE=hybrid 且只想让 TTS 走免费的 edge-tts → VOICE_TTS_PROVIDER=edge_tts
# VOICE_ASR_PROVIDER=
# VOICE_PA_PROVIDER=
# VOICE_TTS_PROVIDER=
# VOICE_LLM_PROVIDER=

# ══════════════════════════════════════════════════════════════════════════════
# 3) Azure AI Speech（发音评测 + TTS）—— 可选，用云评测时必填
#    申请：https://portal.azure.com → 创建 "Azure AI services" / Speech 资源，选 F0(免费) 或 S0(标准)
# ══════════════════════════════════════════════════════════════════════════════
# AZURE_SPEECH_KEY=                     # 密钥；必填（云模式）。切勿提交到 git
# AZURE_SPEECH_REGION=eastasia          # 区域，如 eastasia / southeastasia / eastus
# AZURE_SPEECH_ENDPOINT=                # 可选；留空按 REGION 推导
# AZURE_TTS_VOICE=en-US-JennyNeural     # 可选；默认音色（教学用美音女声，语速可调）

# ══════════════════════════════════════════════════════════════════════════════
# 4) 云端 LLM（OpenAI 兼容：DeepSeek / Qwen / 任何兼容端点）—— 可选
#    DeepSeek 价格见 docs/hardware-cost.md；不开 LLM 时 voice 走模板化反馈，HTTP 仍 200
# ══════════════════════════════════════════════════════════════════════════════
# LLM_BASE_URL=https://api.deepseek.com   # 注意：官方 Base URL 无 /v1 也能用，兼容 OpenAI 格式
# LLM_API_KEY=
# LLM_MODEL=deepseek-flash                # 2026 现行模型名；旧的 deepseek-chat 请以官网为准
# LLM_TIMEOUT_S=30

# 本地 LLM（可选，配合 docker compose --profile local-llm）
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen3:8b

# ══════════════════════════════════════════════════════════════════════════════
# 5) 本地兜底模型（faster-whisper / edge-tts）—— 可选，local / hybrid 模式用
#    首次启动会下载模型到 /models 命名卷（tiny≈75MB，small≈480MB）
# ══════════════════════════════════════════════════════════════════════════════
# WHISPER_MODEL=tiny
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# EDGE_TTS_VOICE=en-US-JennyNeural

# ══════════════════════════════════════════════════════════════════════════════
# 6) 容器内路径 / 参考音缓存 / 预热 —— 一般不用改（默认值已适合家用）
#    变量名与默认值逐项抄自 voice/.env.example 与 voice/README.md §4（V1.5，契约 v1.1 §12）
# ══════════════════════════════════════════════════════════════════════════════
# DATA_DIR=/data                        # SQLite + 音频 + cache/；host 的 ../data 挂到这里
# MODEL_CACHE_DIR=/models               # 模型缓存；命名卷 voice-models
# VOICE_HOST=0.0.0.0
# VOICE_PORT=8100
# DEFAULT_TTS_VOICE=en-US-JennyNeural
# MAX_TTS_CHARS=2000
# VOICE_SERVICE_URL=http://voice:8100   # web 服务端调用 voice 的地址（浏览器不直连 voice）
# TRUST_PROXY=1                         # 前面有 caddy 时置 1

# ---- 参考音 / 参考 F0 缓存（示范音只合成一次，之后全部命中本地缓存）----
# CACHE_ENABLED=true                    # 默认 true。设 false 回退 v1.0 行为：不写缓存，
#                                       # provider_meta.cache 全为 disabled（每次跟读都会重新调云 TTS）
# CACHE_MAX_BYTES=524288000             # 默认 524288000（500MB）。超出按 LRU（mtime 从旧到新）淘汰
# CACHE_MAX_ENTRIES=2000                # 默认 2000（audio + f0 文件合计上限）
# 体积参考（本机实测）：300 条语料 ≈ 600 文件 / 26.6 MiB（平均每条 ≈ 93 KB）。
# 删除 data/cache/ 随时安全：只是要重跑一次预热，练习记录与分数不受影响。

# ---- 预热（POST /v1/warmup 与 voice/scripts/warmup.py）----
# WARMUP_MAX_ITEMS=500                  # 默认 500。单次 /v1/warmup 的 items 上限，超过返回 413
# WARMUP_CONCURRENCY=2                  # 默认 2（可被请求里的 concurrency 覆盖，范围 1–8）。
#                                       # 别贪大：云 TTS 有限流，预热是后台任务不是用户请求

# ══════════════════════════════════════════════════════════════════════════════
# 7) web 侧：初始三账号 + 会话 cookie —— 强烈建议在这里显式设置
#    机制：web 进程第一次收到请求时自动建表；users 表为空则按下面的变量灌种子（幂等）
#    ⚠️ 不填也能跑（web 有内置默认账号），但**默认密码是公开的**，请务必改掉
# ══════════════════════════════════════════════════════════════════════════════
BOOTSTRAP_DAD_EMAIL=dad@example.com
BOOTSTRAP_DAD_PASSWORD=change-me-dad-please
BOOTSTRAP_MOM_EMAIL=mom@example.com
BOOTSTRAP_MOM_PASSWORD=change-me-mom-please
BOOTSTRAP_CHILD_EMAIL=girl@example.com
BOOTSTRAP_CHILD_PASSWORD=change-me-girl-please

# AUTO_SEED=1        # 默认 1：自动建表 + 灌种子。设 0 则关闭（改为手动跑 node scripts/seed.mjs）
# COOKIE_SECURE=0    # 默认 0。**内网 http 访问时必须保持 0**，否则登录 cookie 不下发、登录永远失败；
#                    # 只有公网域名（路径 C，全程 HTTPS）才设 1

# ══════════════════════════════════════════════════════════════════════════════
# 8) 可选 profile
# ══════════════════════════════════════════════════════════════════════════════
# 打开后 `docker compose up -d` 会连 ollama 一起起（全本地 LLM 兜底）
# COMPOSE_PROFILES=local-llm
