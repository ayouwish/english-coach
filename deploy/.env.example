# english-coach · 部署环境变量（复制为 deploy/.env 后按需修改）
#   cp .env.example .env
# 规则：.env 永远不进 git；没有密钥时 PROVIDER_MODE=mock 也能全链路跑通（离线开发/演示）。
# 「必填」= 不填就起不来；「可选」= 不填走默认值。

# ══════════════════════════════════════════════════════════════════════════════
# 1) 部署入口 / TLS —— 必填（决定你从哪个网址访问、麦克风能不能用）
# ══════════════════════════════════════════════════════════════════════════════
# 站点地址。三选一：
#   localhost             本机访问（浏览器把 localhost 当安全上下文，其实不需要证书）
#   192.168.1.23          局域网按 IP 访问（改成你宿主机的真实局域网 IP）
#   coach.example.com     公网域名（配合下面的 TLS_CERT_MODE=邮箱）
# 注意：不要写 http:// 前缀，只写主机名或 IP。
SITE_ADDRESS=localhost

# 证书模式。二选一：
#   internal              用 Caddy 内置 CA 自签（家庭/局域网推荐；客户端要导入 root.crt）
#   you@example.com       走 Let's Encrypt 自动申请（需要 80/443 能从公网访问）
TLS_CERT_MODE=internal

# Caddy 的**宿主 HTTPS 端口**（NAS 上 443 通常被系统 Nginx 占用 → 改成 8443）
# 不设 = 443；设了之后访问地址变成 https://<主机>:8443
# CADDY_HTTPS_PORT=8443
#
# HTTP(80) 默认**不发布**（NAS 上 80/8080 常被系统服务占用，且 NAS 场景不需要跳转）。
# 仅当"公网域名 + Caddy 自动 ACME(HTTP-01)"或"想要 http→https 跳转"时，
# 才去 docker-compose.yml 里取消那行 ports 注释，并设置：
# CADDY_HTTP_PORT=80
#
# Caddyfile 变体：
#   Caddyfile（默认）       → internal CA 自签 / ACME 邮箱自动签发
#   Caddyfile.tls-files      → 用**现成 PEM 证书**（放 deploy/certs/fullchain.pem + privkey.pem）
# CADDYFILE=Caddyfile

# ══════════════════════════════════════════════════════════════════════════════
# 1.5) 构建期镜像源 —— 国内/离线环境强烈建议设置（否则可能拉不到包、构建很慢）
# ══════════════════════════════════════════════════════════════════════════════
# 只在 `docker compose build` 时生效，不影响运行时。
#
# 为什么需要：飞牛/国内直连 registry.npmjs.org、pypi.org 经常超时或被重置。
# 实测症状：deps 阶段装依赖成功，但 builder 阶段 `pnpm build` 去下 pnpm 时报
#   ECONNRESET；或者 pnpm install 一次要 5 分钟以上。
#
# 留空/注释 = 用官方源。国内建议：
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ══════════════════════════════════════════════════════════════════════════════
# 2) voice 服务：provider 总开关 —— 必填
#    本项目采用的组合（2026-10-25 定案）：asr/pa/tts = azure，llm = deepseek（远程）
#    也就是下面这行填 hybrid（云为主 + 本地兜底），再配好第 3、4 节的密钥。
# ══════════════════════════════════════════════════════════════════════════════
# mock   : 确定性假数据，零密钥零下载，用于开发/演示/E2E 测试（想先零成本跑通部署就填这个）
# local  : 全本地（ASR/PA 词级 faster-whisper + TTS piper），零 API 费用，但没有音素级
# cloud  : 全云（Azure ASR + 发音评测 + Neural TTS）
# hybrid : 云为主 + 本地兜底 —— ★ 本项目实际采用的形态
#
# ⚠️ 模板默认给 mock，是为了让第一次部署**零摩擦**：不用密钥、不用下载模型，
#    1 分钟就能验证"容器起没起来、链路通不通"。
#    填好下面第 3、4 节的密钥后，把它改成 hybrid 即为本项目实际使用的组合。
#    注意：hybrid/cloud 在**没有 Azure key** 时会回落到本地模型（faster-whisper / piper），
#    那需要额外下载几百 MB —— 所以"先 mock 跑通、再切 hybrid"是推荐顺序。
PROVIDER_MODE=mock
# PROVIDER_MODE=hybrid
#
#    设置生效后可用 `curl -s localhost:8100/v1/health` 看 providers 到底用了谁，
#    或直接跑 `./scripts/check-deploy.sh` 让它断言 provider 组合。

# 分项覆盖（可选）。留空则按 PROVIDER_MODE 推导；只填一项即可单独切换某个环节。
#   PROVIDER_MODE=hybrid + 只想省 TTS 的钱 → VOICE_TTS_PROVIDER=piper
#   想跑通部署但暂时不花钱        → PROVIDER_MODE=mock（或 VOICE_PA_PROVIDER=mock）
# ⚠️ 切换 provider 会让已有的参考音缓存**全部失效**（缓存键 v3 含 tts_provider 与 fmt，契约 v1.4 §12.2），
#    需要重跑一次预热（docs/deployment.md §6.2）—— 这是有意的设计，不是故障。
# VOICE_ASR_PROVIDER=azure
# VOICE_PA_PROVIDER=azure               # 本地音素级实验用 gop（已实测相关性不达标，默认关闭）
# VOICE_TTS_PROVIDER=azure
# VOICE_LLM_PROVIDER=deepseek

# ══════════════════════════════════════════════════════════════════════════════
# 3) Azure AI Speech（发音评测 + TTS）—— 可选，用云评测时必填
#    申请：https://portal.azure.com → 创建 "Azure AI services" / Speech 资源，选 F0(免费) 或 S0(标准)
# ══════════════════════════════════════════════════════════════════════════════
# AZURE_SPEECH_KEY=                     # 密钥；必填（云模式）。切勿提交到 git
# AZURE_SPEECH_REGION=eastasia          # 区域，如 eastasia / southeastasia / eastus
# AZURE_SPEECH_ENDPOINT=                # 可选；留空按 REGION 推导
# AZURE_TTS_VOICE=en-US-JennyNeural     # 可选；默认音色（教学用美音女声，语速可调）

# ══════════════════════════════════════════════════════════════════════════════
# 4) 云端 LLM（OpenAI 兼容：DeepSeek / Qwen / 任何兼容端点）—— 本项目采用 deepseek（远程）
#    不填也能跑：voice 会返回模板化反馈（provider="template"），HTTP 仍 200
#    DeepSeek 价格见 docs/hardware-cost.md；home 场景月成本约几元
# ══════════════════════════════════════════════════════════════════════════════
# LLM_BASE_URL=https://api.deepseek.com   # 注意：官方 Base URL 无 /v1 也能用，兼容 OpenAI 格式
# LLM_API_KEY=
# LLM_MODEL=deepseek-flash                # 2026 现行模型名；旧的 deepseek-chat 请以官网为准
# LLM_TIMEOUT_S=30

# 本地 LLM（可选，配合 docker compose --profile local-llm；CPU 上 7B 一轮 30–60s，仅作断网兜底）
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen3:8b

# ══════════════════════════════════════════════════════════════════════════════
# 5) 本地兜底模型（faster-whisper / Piper / GOP）—— 可选
#    ★ 本项目定案的组合（全 Azure + 远程 DeepSeek）**不需要下载任何本地模型**：
#      这些依赖是惰性加载的，不装、不下载也能跑主流程，只作断网兜底与实验开关。
#    若确实要用：依赖在 voice/requirements-local.txt，模型下到 /models 命名卷
#    （实测 voice/.local-models 约 888 MB，含 whisper、Piper 音色、GOP 模型 318 MB）
#    provider 矩阵见 voice/README.md §3.2：local 模式的 TTS 默认是 piper（不是 edge-tts）
# ══════════════════════════════════════════════════════════════════════════════
# WHISPER_MODEL=tiny
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# EDGE_TTS_VOICE=en-US-JennyNeural      # 仅在显式把 TTS 切到 edge_tts 时用
# PIPER_VOICE=en_US-lessac-medium       # LOCAL_MODELS_DIR / PIPER_VOICE_DIR 见 voice/README.md §13.2
# GOP_MODEL_PATH=                       # 本地音素级实验用；已实测相关性不达标，默认关闭

# ══════════════════════════════════════════════════════════════════════════════
# 6) 容器内路径 / 参考音缓存 / 预热 —— 一般不用改（默认值已适合家用）
#    变量名与默认值逐项抄自 voice/.env.example 与 voice/README.md §4（契约 v1.4 §12）
# ══════════════════════════════════════════════════════════════════════════════
# DATA_DIR=/data                        # SQLite + 音频 + cache/；host 的 ../data 挂到这里
# MODEL_CACHE_DIR=/models               # 模型缓存；命名卷 voice-models
# VOICE_HOST=0.0.0.0
# VOICE_PORT=8100
# DEFAULT_TTS_VOICE=en-US-JennyNeural
# MAX_TTS_CHARS=2000
# VOICE_SERVICE_URL=http://voice:8100   # web 服务端调用 voice 的地址（浏览器不直连 voice）
# TRUST_PROXY=1                         # 前面有 caddy 时置 1

# ---- 参考音 / 参考 F0 缓存（示范音只合成一次，之后全部命中本地缓存）----
# 键（契约 v1.4 §12.2）：sha1("v3" + tts_provider + fmt + text + voice + rate)
#   → 换 provider / 换格式 / 换音色 / 换语速 / 改文本，旧缓存都不再命中（有意设计）
# CACHE_ENABLED=true                    # 默认 true。设 false 回退 v1.0 行为：不写缓存，
#                                       # provider_meta.cache 全为 disabled（每次跟读都会重新调云 TTS）
# CACHE_MAX_BYTES=524288000             # 默认 524288000（500MB）。超出按 LRU（mtime 从旧到新）淘汰
# CACHE_MAX_ENTRIES=2000                # 默认 2000（audio + f0 文件合计上限）
# 体积参考（本机实测，随 provider/格式变化，以 du -sh data/cache 为准）：
#   Azure WAV 24k：单条示范音平均 144 KB → 300 句 × 2 语速（600 条）≈ 86 MiB
#   早期 mock WAV 16k：600 文件 ≈ 26.6 MiB
# 删除 data/cache/ 随时安全：只是要重跑一次预热，练习记录与分数不受影响。

# ---- 预热（POST /v1/warmup 与 voice/scripts/warmup.py）----
# WARMUP_MAX_ITEMS=500                  # 默认 500。单次 /v1/warmup 的 items 上限，超过返回 413
# WARMUP_CONCURRENCY=2                  # 默认 2（可被请求里的 concurrency 覆盖，范围 1–8）。
#                                       # 别贪大：云 TTS 有限流，预热是后台任务不是用户请求
# 一键预热（两种语速，幂等）：./scripts/warm-corpus.sh
#   开发机/本机直跑用它；NAS 上用容器内命令，见 docs/nas-deployment.md §4.6

# ══════════════════════════════════════════════════════════════════════════════
# 7) web 侧：初始三账号 + 会话 cookie —— 强烈建议在这里显式设置
#    机制：web 进程第一次收到请求时自动建表；users 表为空则按下面的变量灌种子（幂等）
#    ⚠️ 不填也能跑（web 有内置默认账号），但**默认密码是公开的**，请务必改掉
# ══════════════════════════════════════════════════════════════════════════════
BOOTSTRAP_DAD_EMAIL=dad@example.com
BOOTSTRAP_DAD_PASSWORD=change-me-dad-please
BOOTSTRAP_MOM_EMAIL=mom@example.com
BOOTSTRAP_MOM_PASSWORD=change-me-mom-please
BOOTSTRAP_CHILD_EMAIL=girl@example.com
BOOTSTRAP_CHILD_PASSWORD=change-me-girl-please

# AUTO_SEED=1        # 默认 1：自动建表 + 灌种子。设 0 则关闭（改为手动跑 node scripts/seed.mjs）
# COOKIE_SECURE=0    # 默认 0。**内网 http 访问时必须保持 0**，否则登录 cookie 不下发、登录永远失败。
#                    # 设 1 的场合：浏览器实际访问的是 https —— 公网域名（路径 C）、
#                    # 或 NAS 反向代理 / Caddy 已经终结 TLS（docs/nas-deployment.md §4.2、§6.2）。
#                    # 判断标准只有一条：你在地址栏里看到的是不是 https + 锁头。

# ══════════════════════════════════════════════════════════════════════════════
# 8) 可选 profile
# ══════════════════════════════════════════════════════════════════════════════
# 打开后 `docker compose up -d` 会连 ollama 一起起（全本地 LLM 兜底）
# COMPOSE_PROFILES=local-llm
