{
  "name": "english-coach-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/migrate.mjs --reset && node scripts/seed.mjs",
    "db:cleanup": "node scripts/cleanup-user-data.mjs",
    "mock:voice": "node scripts/mock-voice.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "check:phoneme-hints": "node scripts/check-phoneme-hints.mjs",
    "check:child-ipa": "node scripts/check-child-ipa.mjs",
    "check:practice-ui": "node scripts/check-practice-ui.mjs",
    "check:warmup": "node scripts/check-warmup.mjs",
    "check:diagnosis": "node scripts/check-diagnosis.mjs",
    "check:chat-speech": "node scripts/check-chat-speech.mjs",
    "check:suggestions": "node scripts/check-suggestions.mjs",
    "check:flow": "node scripts/check-flow.mjs",
    "check:materials": "node scripts/check-materials.mjs",
    "check:encouragement": "node scripts/check-encouragement.mjs",
    "check:story": "node scripts/check-story.mjs",
    "check:family": "node scripts/check-family.mjs",
    "check:auth": "node scripts/check-auth.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.44.6",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.8",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  }
}
