# ── 依赖与构建产物 ─────────────────────────────────────────
node_modules/
.next/
out/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.uv-cache/
.model-cache/
*.tsbuildinfo

# ── 运行数据（含家庭隐私 + 可再生的缓存，绝不入库）────────────
# web: SQLite 数据库 + 孩子的录音；voice: 参考音/F0 缓存（几百 MB，可重新预热）
#
# ⚠️ 必须写**锚定路径**。早期这里写的是笼统的 `data/`，它匹配任意层级叫 data 的目录，
#    于是把 `web/src/data/`（300 句语料 / 场景 / 种子账号）也一起忽略了 ——
#    结果是"仓库能 clone 但跑不起来"，CI 的类型检查直接报
#    `Cannot find module '@/data/sentences.json'`。开源仓库绝不能少了这些源码数据。
/data/
/web/data/
/voice/data/
*.db
*.db-wal
*.db-shm
*.db-journal

# ── 密钥与本地配置（绝对不要提交）──────────────────────────
.env
.env.local
.env.*.local

# ── 临时文件 ───────────────────────────────────────────────
*.log
.warmup-corpus.txt
.probe*
.pytest-last.log

# 操作系统的杂物
.DS_Store
Thumbs.db
# 部署/调试脚本产生的临时文件（不要进仓库）
.rss.log
.tone.wav
deploy/.*.log
deploy/.*.wav

# 编辑器临时/交换文件（vi/vim 打开 .env 时会生成 .env.swp —— 里面是明文的密钥副本！）
*.swp
*.swo
*.swn
*~
# 证书私钥（部署时放进 deploy/certs/，绝不能进仓库）
deploy/certs/*
!deploy/certs/.gitkeep
*.pem
!*/caddy-root-ca.crt
