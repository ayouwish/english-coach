# ---- 通用 ----
PROVIDER_MODE=mock            # mock | local | cloud | hybrid
VOICE_HOST=0.0.0.0
VOICE_PORT=8100
DATA_DIR=./data               # 容器内 /data；音频落 $DATA_DIR/audio/
MODEL_CACHE_DIR=./.model-cache  # 容器内 /models
DEFAULT_TTS_VOICE=en-US-JennyNeural
MAX_TTS_CHARS=2000

# ---- 参考音 / 参考 F0 缓存（契约 v1.1 §12）----
CACHE_ENABLED=true
CACHE_MAX_BYTES=524288000     # 500MB
CACHE_MAX_ENTRIES=2000
WARMUP_MAX_ITEMS=500
WARMUP_CONCURRENCY=2

# ---- 分项 provider 覆盖（可选；默认由 PROVIDER_MODE 推导）----
# VOICE_ASR_PROVIDER=azure
# VOICE_PA_PROVIDER=azure
# VOICE_TTS_PROVIDER=azure
# VOICE_LLM_PROVIDER=deepseek

# ---- Azure Speech（可选）----
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_ENDPOINT=
# AZURE_TTS_VOICE=en-US-JennyNeural

# ---- LLM（OpenAI 兼容：DeepSeek / Ollama / vLLM ...）----
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT_S=30

# ---- 拍照 OCR（task-27：默认走 LLM 视觉；本地 rapidocr 只是可选离线兜底）----
# auto = 配了 LLM 用 LLM，否则用本地（若装了 requirements-ocr-local.txt）
# VOICE_OCR_PROVIDER=auto
# 推理模型（deepseek-flash）会先输出 reasoning，800 会被思考吃光 → 默认 1500 且默认关思考
# OCR_MAX_TOKENS=1500
# OCR_DISABLE_THINKING=1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ---- 本地模型（task-20：Piper TTS / faster-whisper ASR / GOP PA）----
# 模型从 ModelScope 下载后放这里（不进 git）；容器里建议 /models/local
# LOCAL_MODELS_DIR=./.local-models
# PIPER_VOICE=en_US-lessac-medium
# PIPER_VOICE_DIR=./.local-models/piper
# WHISPER_MODEL=small.en
# WHISPER_MODEL_PATH=./.local-models/whisper/small.en
# WHISPER_CPU_THREADS=4
# GOP_MODEL_PATH=./.local-models/gop/model_int8.onnx

# ---- 本地兜底（faster-whisper / edge-tts）----
# WHISPER_MODEL=tiny
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# EDGE_TTS_VOICE=en-US-JennyNeural

# ---- TTS WAV 首尾静音裁剪（task-39：Azure 短词尾部 ~1.3s 低电平噪声）----
# TTS_TRIM_SILENCE=1
# TTS_TRIM_THRESHOLD_DB=-50
# TTS_TRIM_KEEP_MS=50

# ---- 文生图（task-52：故事 -> 儿童绘本插画，智谱 GLM-Image）----
# IMAGE_PROVIDER=none          # zhipu | mock | none（默认 none=未启用）
# IMAGE_API_KEY=<bigmodel.cn 的 API Key>
# IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# IMAGE_MODEL=glm-image
# IMAGE_SIZE=1280x1280
# IMAGE_WATERMARK=1            # 默认开启（合规）；关闭需在智谱控制台签免责声明
# IMAGE_TIMEOUT_S=120

# ---- Azure ASR 连续识别（task-56：中间停顿不能只识别前半句）----
# AZURE_SEGMENTATION_SILENCE_TIMEOUT_MS=1500
# AZURE_ASR_TIMEOUT_S=60

# ---- 预置卡通形象库 / 照片生成策略（task-63）----
# 照片生成形象默认关闭（隐私策略）：1 才允许 POST /v1/image/avatar
# IMAGE_AVATAR_PHOTO=0
# 预置形象产物目录（生成脚本输出，web 静态目录）
# AVATAR_PRESETS_DIR=../web/public/avatars/presets

# ---- 对话轮数（task-69：默认不因轮数结束，只由模型语义收尾）----
# CHAT_DONE_TURN_INDEX=0   # >0 时到该轮次强制 done=true（测试/演示用）
